{
  "name": "client-project-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start_dev.ps1",
    "dev:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/clean-dev-cache.ps1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop_dev.ps1",
    "status": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/status-port.ps1 -Port 3000",
    "lint": "eslint",
    "codegen": "graphql-codegen --config codegen.js",
    "codegen:watch": "graphql-codegen --config codegen.js --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@apollo/client": "^4.2.8",
    "@apollo/client-integration-nextjs": "^0.14.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.5.7",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "country-state-city": "^3.2.1",
    "dompurify": "^3.4.13",
    "framer-motion": "^12.43.0",
    "graphql": "^16.14.2",
    "isomorphic-dompurify": "^3.22.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.27.0",
    "mermaid": "^11.16.1",
    "mime": "^4.1.0",
    "monaco-editor": "^0.56.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.2.108",
    "pretty-bytes": "^7.1.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "react-zoom-pan-pinch": "^4.0.4",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.16.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-tools/schema": "^10.0.38",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "graphql-yoga": "^5.21.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "vitest": "^4.1.10"
  }
}
